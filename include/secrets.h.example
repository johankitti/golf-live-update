#pragma once

// Copy this file to include/secrets.h and fill in your Wi-Fi credentials.
// include/secrets.h is gitignored, so your password never gets committed.
//
// The #ifndef guards let build environments override these — the `wokwi`
// simulator env injects Wokwi-GUEST via build flags in platformio.ini.

#ifndef WIFI_SSID
#define WIFI_SSID "your-wifi-name"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "your-wifi-password"
#endif
